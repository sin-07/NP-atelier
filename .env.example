# MongoDB Atlas Database Connection
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@cluster0.fhmihhu.mongodb.net/atelier_db?retryWrites=true&w=majority&appName=Cluster0
MONGODB_DB=atelier_db

# Cloudinary Environment Configuration (for product image & branding logo uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_URL=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# Optional: Automatic Live Google Reviews Sync (configure EITHER Google Places OR Free Featurable Widget ID)
# Option 1 (All reviews free): Create a free Google Review widget on featurable.com and set its Widget ID
FEATURABLE_WIDGET_ID=
# Option 2 (Google Places API v1): Server finds NP Atelier Place ID automatically if GOOGLE_PLACE_ID is omitted
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
